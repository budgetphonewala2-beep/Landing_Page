# Public site URL, with no trailing slash.
# Used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
# Defaults to https://landing-page-alpha-red-22.vercel.app when unset. Set it in
# Vercel (Project Settings -> Environment Variables) only for a custom domain
# you own.
NEXT_PUBLIC_SITE_URL=https://landing-page-alpha-red-22.vercel.app

# NOTE: this website needs no API keys and no secrets.
# Do not add Razorpay key secrets or any other secret to this file.
